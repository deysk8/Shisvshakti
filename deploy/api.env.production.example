# Copy to apps/api/.env on the production server

NODE_ENV=production
PORT=4000
API_PREFIX=api/v1

DATABASE_URL=postgresql://shivasakti:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/shivasakti?schema=public

JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_40_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_40_CHARS_MINIMUM
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=https://www.shivshaktibuses.com,https://shivshaktibuses.com
APP_PUBLIC_URL=https://www.shivshaktibuses.com
API_PUBLIC_URL=https://api.shivshaktibuses.com/api/v1

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
CASHFREE_WEBHOOK_SECRET=

EMAIL_PROVIDER=resend
EMAIL_FROM=bookings@shivshaktibuses.com
RESEND_API_KEY=

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

PROD_ADMIN_EMAIL=admin@shivshaktibuses.com
PROD_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SEED_DEV_USERS=false
