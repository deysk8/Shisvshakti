# Server — copy to apps/api/.env

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# PostgreSQL (matches docker/docker-compose.yml defaults)
DATABASE_URL=postgresql://shivasakti:shivasakti_dev_change_me@localhost:5432/shivasakti?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (Phase 4 — generate strong secrets for production)
JWT_ACCESS_SECRET=dev_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS
CORS_ORIGINS=http://localhost:3000

# Cashfree Payment Gateway (sandbox keys from merchant dashboard)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=

# Maps (Phase 15 — server-side only; web uses free OpenStreetMap by default)
MAP_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# Email (Phase 14)
EMAIL_PROVIDER=resend
EMAIL_FROM=bookings@shivasakti.in
RESEND_API_KEY=

# SMS / WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Prefer API Key (Console → Account → API keys) over main Auth Token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
# Approved WhatsApp Content Template SID (from Twilio Console → Content Template Builder)
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storage (Phase 13 — PDF / bus images)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Tracking
TRACKING_MODE=demo
GPS_INGEST_SECRET=dev_gps_secret_change_me

# App
APP_PUBLIC_URL=http://localhost:3000
# Public API base URL — used for ticket PDF links and partner docs
API_PUBLIC_URL=http://localhost:4000/api/v1

# Partner webhooks (HMAC signature for OTA inventory push)
PARTNER_WEBHOOK_HMAC_SECRET=dev-partner-webhook-secret-change-in-production-min-32-chars

# Production bootstrap (only when NODE_ENV=production and running seed)
# PROD_ADMIN_EMAIL=admin@yourdomain.com
# PROD_ADMIN_PASSWORD=your-strong-password
# SEED_DEV_USERS=false
